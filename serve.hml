// Hemlock Documentation Server
// Serves docs.html, llms.txt and their translations using Sprout.
// Routes and handlers live in server.hml.

import {
    create_app, load_content, supported_langs,
    docs_filename, llms_filename, lang_name
} from "./server.hml";
import { exit } from "@stdlib/env";

// Read all documentation files at startup (missing files are optional)
let content = load_content("");

// English docs are the fallback for every other language, so they are required
if (content.docs["en"] == null) {
    print("Error: docs.html not found");
    print("Run this from the hem-doc directory");
    exit(1);
}

let app = create_app(content);

// Serve on port 5169
let port = 5169;

fn pad(s, width) {
    while (s.length < width) {
        s = s + " ";
    }
    return s;
}

app.listen(port, fn() {
    let base = "http://localhost:" + port;
    print("Hemlock Documentation Server");
    print("Serving docs at " + base);
    for (let lang in supported_langs) {
        let path = lang == "en" ? "/" : "/" + docs_filename(lang);
        print("  " + pad(lang_name(lang) + ":", 12) + base + path);
    }
    print("LLM docs:");
    for (let lang in supported_langs) {
        print("  " + pad(lang_name(lang) + ":", 12) + base + "/" + llms_filename(lang));
    }
    print("Other: /robots.txt /sitemap.xml /favicon.ico /health");
});
